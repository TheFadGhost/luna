#!/usr/bin/env python3
"""luna — command-line client for lunad.

A thin, dependency-free socket client. It holds no state and knows nothing
about memory or agents: everything happens in the daemon, which is the whole
point of the socket (ARCHITECTURE.md section 3).
"""

from __future__ import annotations

import argparse
import json
import os
import socket
import sys
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lunad import config  # noqa: E402

BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    BOLD = DIM = RESET = ""

NOT_RUNNING = f"""\
luna: the daemon is not running (no listener on {config.SOCKET_PATH}).

  start it   : systemctl --user start lunad
  enable it  : systemctl --user enable --now lunad
  why it died: systemctl --user status lunad  |  luna log
"""


class Client:
    def __init__(self, path: Path = config.SOCKET_PATH, timeout: float = 600.0) -> None:
        self.path = path
        self.timeout = timeout
        self.sock: socket.socket | None = None
        self.fh = None

    def __enter__(self) -> "Client":
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        try:
            s.connect(str(self.path))
        except (FileNotFoundError, ConnectionRefusedError):
            s.close()
            sys.stderr.write(NOT_RUNNING)
            raise SystemExit(69)  # EX_UNAVAILABLE
        except OSError as exc:
            s.close()
            sys.stderr.write(f"luna: cannot reach the daemon: {exc}\n")
            raise SystemExit(69)
        self.sock = s
        self.fh = s.makefile("rwb")
        return self

    def __exit__(self, *exc: object) -> None:
        if self.fh:
            self.fh.close()
        if self.sock:
            self.sock.close()

    def call(self, op: str, **payload: object) -> dict:
        assert self.fh is not None
        request = {"op": op, "id": uuid.uuid4().hex[:12], **payload}
        self.fh.write((json.dumps(request) + "\n").encode())
        self.fh.flush()
        line = self.fh.readline()
        if not line:
            sys.stderr.write("luna: the daemon closed the connection mid-request. "
                             "Check `luna log`.\n")
            raise SystemExit(70)
        return json.loads(line)


def fail(resp: dict) -> int:
    sys.stderr.write(f"luna: {resp.get('error', 'Error')}: "
                     f"{resp.get('message', '(no detail)')}\n")
    for key in ("usage_pct", "overflow", "returncode", "stderr", "sample"):
        if key in resp:
            sys.stderr.write(f"  {key}: {resp[key]}\n")
    return 1


# --------------------------------------------------------------------------


def cmd_ask(args: argparse.Namespace) -> int:
    prompt = " ".join(args.prompt).strip() or sys.stdin.read().strip()
    if not prompt:
        sys.stderr.write("luna: nothing to ask\n")
        return 2
    with Client(timeout=args.timeout + 30) as client:
        request_id = uuid.uuid4().hex[:12]
        try:
            payload = {"prompt": prompt, "surface": args.surface,
                       "model": args.model, "timeout": args.timeout,
                       "id": request_id, "remember": not args.no_remember,
                       "conversation": args.conversation}
            if args.speak:
                payload["speak"] = True
            resp = client.call("ask", **payload)
        except KeyboardInterrupt:
            with Client(timeout=10) as c2:
                c2.call("cancel", target=request_id)
            sys.stderr.write("\nluna: cancelled\n")
            return 130
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    print(resp["reply"])
    if args.verbose:
        cost = resp.get("cost_usd")
        bits = [str(resp.get("model") or resp.get("agent")),
                f"{resp.get('wall_ms', 0) / 1000:.1f}s"]
        if cost is not None:
            bits.append(f"${cost:.4f}")
        if resp.get("recalled"):
            bits.append("recalled")
        bits.append("resumed" if resp.get("resumed") else "new session")
        sys.stderr.write(f"{DIM}[{' · '.join(bits)}]{RESET}\n")
    return 0


def cmd_say(args: argparse.Namespace) -> int:
    text = " ".join(args.text).strip() or sys.stdin.read().strip()
    if not text:
        sys.stderr.write("luna: nothing to say\n")
        return 2
    with Client(timeout=args.timeout + 30) as client:
        resp = client.call("say", text=text, wait=args.wait,
                           timeout=args.timeout)
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    if not resp.get("sentences"):
        sys.stderr.write(f"luna: {resp.get('note', 'nothing speakable')}\n")
        return 1
    bits = [f"{resp['sentences']} sentence(s)"]
    if resp.get("provider"):
        bits.append(str(resp["provider"]))
    if resp.get("sample_rate"):
        bits.append(f"{resp['sample_rate']} Hz")
    if resp.get("first_audio_ms") is not None:
        bits.append(f"first audio {resp['first_audio_ms']} ms")
    if resp.get("total_ms") is not None:
        bits.append(f"total {resp['total_ms']} ms")
    print(resp["spoken"])
    sys.stderr.write(f"{DIM}[{' · '.join(bits)}]{RESET}\n")
    return 0


def cmd_hush(args: argparse.Namespace) -> int:
    with Client(timeout=15) as client:
        resp = client.call("speak.cancel")
    if not resp.get("ok"):
        return fail(resp)
    print("stopped" if resp["cancelled"] else resp.get("note", "nothing was speaking"))
    return 0


def cmd_session(args: argparse.Namespace) -> int:
    with Client(timeout=15) as client:
        resp = client.call("session.reset", conversation=args.conversation)
    if not resp.get("ok"):
        return fail(resp)
    print(f"dropped {resp['dropped']} session(s)")
    return 0


def cmd_codex_profile(args: argparse.Namespace) -> int:
    with Client(timeout=30) as client:
        resp = client.call("codex.profile")
    if not resp.get("ok"):
        return fail(resp)
    print(f"wrote {resp['path']}\nuse it with: {resp['usage']}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    with Client(timeout=15) as client:
        resp = client.call("status")
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    d, a, m, act = resp["daemon"], resp["agent"], resp["memory"], resp["activity"]
    print(f"{BOLD}lunad{RESET} {d['version']}  pid {d['pid']}  "
          f"up {d['uptime_s']:.0f}s  threads {d['threads']}")
    print(f"  socket   {d['socket']}")
    print(f"  agent    {a['name']} "
          f"({'ready' if a['available'] else 'UNAVAILABLE'}) — {a['detail']}")
    for name, u in m["tier1"].items():
        bar_len = 20
        filled = min(bar_len, int(bar_len * u["pct"] / 100))
        bar = "#" * filled + "." * (bar_len - filled)
        print(f"  {name:<8} [{bar}] {u['chars']}/{u['cap']} chars "
              f"({u['pct']}%) · {u['entries']} entries")
    t2 = m["tier2"]
    print(f"  episodes {t2['episodes']} rows, {t2['size_bytes']} bytes, "
          f"mean salience {t2['mean_salience']}")
    t3 = m.get("tier3") or {}
    if t3.get("exists"):
        print(f"  profile  {t3.get('facts', 0)} fact(s) in "
              f"{len(t3.get('slots') or [])} slot(s), "
              f"{t3.get('corrections', 0)} correction(s), from "
              f"{t3.get('episodes', 0)} episodes "
              f"{DIM}(rebuilt {t3.get('iso') or '?'}){RESET}")
    else:
        print(f"  profile  {DIM}not built yet — "
              f"luna memory profile --rebuild{RESET}")
    con = resp.get("consolidation") or {}
    if con.get("enabled"):
        print(f"  consolidate every {con['every_turns']} turns "
              f"({con['turns_since']} since) · {con['passes']} pass(es), "
              f"{con['added']} added, {con['removed']} removed, "
              f"${con['cost_usd']:.4f}"
              + (" · RUNNING" if con.get("running") else ""))
    else:
        print(f"  consolidate {DIM}off "
              f"([memory] consolidate_every_turns = 0)"
              f"{RESET}")
    print(f"  activity {act['counters']['ask']} asks, "
          f"{act['counters']['errors']} errors, "
          f"{len(act['in_flight'])} in flight, "
          f"${act['session_cost_usd']:.4f} this session")
    for run in act["in_flight"]:
        print(f"    - {run['id']} {run['age_s']}s  {run['prompt']!r}")

    sp = resp.get("speech") or {}
    state = "speaking" if sp.get("speaking") else (
        "loaded" if sp.get("loaded") else "unloaded")
    print(f"  speech   {sp.get('voice')} — {state}"
          + (f", pid {sp['pid']}, {sp.get('load_ms')} ms load" if sp.get("pid")
             else f", unloads after {sp.get('idle_unload_s', 0):.0f}s idle"))
    dsp = resp.get("dispatch") or {}
    ws = dsp.get("workspace") or {}
    if ws.get("available"):
        print(f"  workspace {ws['workspace']} — "
              f"{'visible' if ws.get('visible') else 'hidden'}, "
              f"{ws.get('windows', 0)} window(s), "
              f"{len(dsp.get('running', []))} job(s) running")
    else:
        print(f"  workspace unavailable — {ws.get('detail', '?')}")
    for job in dsp.get("running", []):
        print(f"    - {job['id']} → {job['to']} {job['elapsed_s']}s "
              f"{job['task'][:60]!r}")
    spawned = resp.get("spawned") or {}
    aud = resp.get("audit") or {}
    print(f"  firewall {spawned.get('tracked', 0)} pid(s) tracked, "
          f"{spawned.get('refusals', 0)} refusal(s) · "
          f"audit {aud.get('size_bytes', 0)} bytes")

    se = resp.get("sessions") or {}
    c = se.get("counters", {})
    print(f"  sessions {len(se.get('live', []))} live · "
          f"{c.get('new', 0)} new, {c.get('resumed', 0)} resumed, "
          f"{c.get('retired', 0)} retired")
    for live in se.get("live", []):
        print(f"    - {live['key']}: {live['turns']} turns, "
              f"idle {live['idle_s']:.0f}s, ${live['cost_usd']:.4f}")
    return 0


def cmd_memory(args: argparse.Namespace) -> int:
    with Client(timeout=30) as client:
        if args.mem_cmd == "show":
            resp = client.call("memory.read", file=args.file, limit=args.limit)
        elif args.mem_cmd == "search":
            resp = client.call("memory.search",
                               query=" ".join(args.query), limit=args.limit)
        elif args.mem_cmd == "write":
            resp = client.call("memory.write", file=args.file or "LUNA.md",
                               mode="append", entry=" ".join(args.entry))
        elif args.mem_cmd == "rm":
            resp = client.call("memory.write", file=args.file or "LUNA.md",
                               mode="remove", index=args.index)
        elif args.mem_cmd == "profile":
            resp = client.call("memory.profile", rebuild=args.rebuild)
        else:  # pragma: no cover - argparse guarantees a subcommand
            return 2
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)

    if args.mem_cmd == "search":
        if not resp["results"]:
            print(f"{DIM}no episodes match {resp['query']!r}{RESET}")
            return 0
        for hit in resp["results"]:
            print(f"{BOLD}{hit['iso']}{RESET} "
                  f"{DIM}[{hit['surface']} · salience "
                  f"{hit['effective_salience']:.2f} of {hit['salience']:.2f}]{RESET}")
            print(f"  > {hit['user_text'].strip()}")
            reply = hit["luna_text"].strip().replace("\n", "\n    ")
            print(f"    {reply}\n")
        return 0

    if args.mem_cmd == "profile":
        return _print_profile(resp)

    if args.mem_cmd in ("write", "rm"):
        u = resp["usage"]
        print(f"{u['file']}: {u['chars']}/{u['cap']} chars ({u['pct']}%), "
              f"{u['entries']} entries")
        return 0

    if args.file:
        u = resp["usage"]
        print(f"{BOLD}{resp['file']}{RESET} {DIM}{u['chars']}/{u['cap']} chars "
              f"({u['pct']}%){RESET}")
        for i, entry in enumerate(resp["entries"]):
            print(f"  [{i}] {entry}")
        return 0

    for name, block in resp["tier1"].items():
        u = block["usage"]
        print(f"{BOLD}{name}{RESET} {DIM}{u['chars']}/{u['cap']} chars "
              f"({u['pct']}%){RESET}")
        for i, entry in enumerate(block["entries"]):
            print(f"  [{i}] {entry}")
        if not block["entries"]:
            print(f"  {DIM}(empty){RESET}")
    print(f"\n{BOLD}recent episodes{RESET} "
          f"{DIM}({resp['tier2']['episodes']} total){RESET}")
    for ep in resp["recent"]:
        print(f"  {ep['iso']} [{ep['surface']} {ep['effective_salience']:.2f}] "
              f"{ep['user_text'].strip()[:80]}")
    t3 = resp.get("tier3") or {}
    print(f"\n{BOLD}derived profile{RESET} "
          + (f"{DIM}{t3.get('facts', 0)} fact(s) from {t3.get('episodes', 0)} "
             f"episodes, rebuilt {t3.get('iso') or '?'} · "
             f"luna memory profile{RESET}"
             if t3.get("exists")
             else f"{DIM}not built yet — luna memory profile --rebuild{RESET}"))
    return 0


def _print_profile(resp: dict) -> int:
    """Tier 3, read the way the other tiers are.

    The rendered `block` is printed rather than the raw JSON because the block
    is what the consolidation pass actually reads, and showing the user
    something other than what the model sees would defeat the point of being
    able to look.
    """
    st = resp.get("status") or {}
    if not st.get("exists"):
        print(f"{DIM}no profile yet. It is derived from episodic memory, so "
              f"there is nothing to derive until there are episodes.{RESET}")
        print(f"{DIM}build one: luna memory profile --rebuild{RESET}")
        return 0
    print(f"{BOLD}profile.json{RESET} {DIM}{st.get('facts', 0)} fact(s) from "
          f"{st.get('episodes', 0)} episodes · rebuilt {st.get('iso')} · "
          f"{st.get('size_bytes', 0)} bytes{RESET}")
    block = (resp.get("block") or "").strip()
    print(block if block else f"{DIM}(nothing measurable yet){RESET}")
    print(f"\n{DIM}derived from tier 2 and safe to delete; the next rebuild "
          f"reproduces it. {st.get('path')}{RESET}")
    return 0


def cmd_dispatch(args: argparse.Namespace) -> int:
    task = " ".join(args.task).strip() or sys.stdin.read().strip()
    if not task:
        sys.stderr.write("luna: nothing to dispatch\n")
        return 2
    timeout = args.timeout + 60 if args.wait else 30
    with Client(timeout=timeout) as client:
        resp = client.call("dispatch", task=task, to=args.to,
                           timeout=args.timeout, wait=args.wait,
                           wait_timeout=args.timeout)
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    print(resp["announce"])
    if not args.wait:
        return 0
    print()
    if resp.get("output"):
        print(resp["output"].rstrip())
    state, code = resp.get("state"), resp.get("exit_code")
    sys.stderr.write(f"{DIM}[{state} · exit {code} · "
                     f"{resp.get('elapsed_s')}s · {resp.get('dir')}]{RESET}\n")
    return 0 if state == "finished" else 1


def _job_line(job: dict) -> str:
    mark = {"finished": "ok  ", "failed": "FAIL", "running": "run ",
            "cancelled": "cxl ", "orphaned": "orph"}.get(job["state"], "?   ")
    code = "" if job.get("exit_code") is None else f" exit {job['exit_code']}"
    return (f"{BOLD}{job['id']}{RESET} {mark} {job['to']:<6} "
            f"{job['elapsed_s']:>6.1f}s{code}  {DIM}{job['iso']}{RESET}\n"
            f"     {job['task'].splitlines()[0][:100]}")


def cmd_jobs(args: argparse.Namespace) -> int:
    with Client(timeout=30) as client:
        if args.cancel:
            resp = client.call("jobs", cancel=args.cancel)
            if not resp.get("ok"):
                return fail(resp)
            print(f"cancelled {resp['cancelled']}"
                  + (f" — {resp['note']}" if resp.get("note") else ""))
            return 0
        resp = client.call("jobs", limit=args.limit, output=args.output)
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    ws = resp.get("workspace") or {}
    print(f"{DIM}{ws.get('workspace')} — "
          f"{'visible' if ws.get('visible') else 'hidden'}, "
          f"{ws.get('windows', 0)} window(s){RESET}")
    if not resp["jobs"]:
        print(f"{DIM}no jobs dispatched yet{RESET}")
        return 0
    for job in resp["jobs"]:
        print(_job_line(job))
        if args.output and job.get("output"):
            body = job["output"].rstrip().replace("\n", "\n     ")
            print(f"     {DIM}{body}{RESET}")
    return 0


def cmd_peek(args: argparse.Namespace) -> int:
    with Client(timeout=30) as client:
        resp = client.call("peek")
    if not resp.get("ok"):
        return fail(resp)
    print(f"{resp['workspace']} "
          + ("visible" if resp["visible"] else "hidden"))
    return 0


def cmd_audit(args: argparse.Namespace) -> int:
    with Client(timeout=30) as client:
        resp = client.call("audit", since=args.since, limit=args.limit,
                           action=args.action)
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    if not resp["entries"]:
        print(f"{DIM}nothing in the audit log for that window "
              f"({resp['path']}){RESET}")
        return 0
    skip = {"ts", "iso", "action", "actor", "ok", "why", "undo", "by_pid"}
    for entry in resp["entries"]:
        status = "" if entry.get("ok") is None else (
            " ok" if entry["ok"] else " FAILED")
        print(f"{DIM}{entry.get('iso', '?')}{RESET} "
              f"{BOLD}{entry.get('action', '?')}{RESET}"
              f"{status} {DIM}({entry.get('actor', 'luna')}){RESET}")
        if entry.get("why"):
            print(f"    why: {str(entry['why']).splitlines()[0][:160]}")
        rest = " ".join(f"{k}={_short(v)}" for k, v in entry.items()
                        if k not in skip)
        if rest:
            print(f"    {DIM}{rest[:400]}{RESET}")
        if entry.get("undo"):
            undo = entry["undo"]
            cmd = " ".join(undo.get("cmd", [])) or "(no command)"
            print(f"    undo: {cmd}  {DIM}({undo.get('valid_while', '')}){RESET}")
    sys.stderr.write(f"{DIM}[{resp['count']} entries · {resp['size_bytes']} "
                     f"bytes · {resp['path']}]{RESET}\n")
    return 0


def _short(value: object) -> str:
    text = value if isinstance(value, str) else json.dumps(value, default=str)
    text = " ".join(str(text).split())
    return text if len(text) <= 90 else text[:87] + "..."


def cmd_spawned(args: argparse.Namespace) -> int:
    """Inspect the signal allowlist — and ask it about any pid at all."""
    with Client(timeout=30) as client:
        resp = client.call("spawned", check=args.check, all=args.all)
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    check = resp.get("check")
    if check:
        verdict = "MAY SIGNAL" if check["may_signal"] else "REFUSED"
        print(f"{BOLD}pid {check['pid']}: {verdict}{RESET}")
        if check.get("reason"):
            print(f"  reason:  {check['reason']}")
        if check.get("cmdline"):
            print(f"  cmdline: {check['cmdline']}")
        print()
    print(f"{DIM}{resp['tracked']} tracked, {resp['refusals']} refusal(s) "
          f"this session · {resp['path']}{RESET}")
    for rec in resp["entries"]:
        alive = "alive" if rec["alive"] else "dead "
        print(f"  {rec['pid']:>8} {alive} {rec['kind']:<12} "
              f"{DIM}{rec['iso']}  {' '.join(rec['cmd'])[:70]}{RESET}")
    return 0


def cmd_settings(args: argparse.Namespace) -> int:
    """Read and write ~/.config/jarvis/config.toml through the daemon.

    Through the daemon rather than the file directly, so that what is printed
    is what lunad is actually using — a value that fell back to its default
    because the file said something invalid reads back as the default here,
    which is the honest answer.
    """
    with Client(timeout=30) as client:
        if args.set_cmd == "set":
            value = _parse_value(args.value)
            resp = client.call("settings.set", key=args.key, value=value,
                               actor="cli", why="set from the CLI")
        else:
            resp = client.call("settings.get", key=args.key)
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)
    if args.set_cmd == "set":
        for key, value in resp["applied"].items():
            print(f"{key} = {_toml(value)}")
        sys.stderr.write(f"{DIM}[{resp['path']}]{RESET}\n")
        return 0
    if args.key:
        spec = f" {DIM}({resp['kind']}"
        if resp.get("choices"):
            spec += ": " + " | ".join(resp["choices"])
        spec += f", default {_toml(resp['default'])}){RESET}"
        print(f"{args.key} = {_toml(resp['value'])}{spec}")
        return 0
    for section, values in resp["settings"].items():
        print(f"{BOLD}[{section}]{RESET}")
        for key, value in values.items():
            print(f"  {key} = {_toml(value)}")
    sec = resp.get("secrets") or {}
    print(f"\n{DIM}{resp['path']} mode {resp.get('mode')} · "
          f"{resp.get('reloads', 0)} reload(s) · "
          f"watching {resp.get('watching')}{RESET}")
    print(f"{DIM}api key: "
          + (f"present from {sec.get('source')}" if sec.get("present")
             else "MISSING — " + str(sec.get("hint", "")))
          + RESET)
    for problem in resp.get("problems") or []:
        sys.stderr.write(f"  ! {problem}\n")
    return 0


def _parse_value(raw: str) -> object:
    """CLI arguments are strings; the schema is typed. Bridge honestly.

    `true`/`false` and numbers are converted, everything else stays a string.
    The daemon validates whatever comes out, so a wrong guess here is a clear
    error rather than a silently stored wrong type.
    """
    text = raw.strip()
    if text.lower() in ("true", "false"):
        return text.lower() == "true"
    try:
        return int(text)
    except ValueError:
        pass
    try:
        return float(text)
    except ValueError:
        pass
    return text


def _toml(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    return json.dumps(value)


def cmd_confirm(args: argparse.Namespace) -> int:
    """List pending questions, answer one, or raise one.

    `luna confirm ask` is the tool-side gate a dispatched agent is told to
    call. It blocks until the user answers or the prompt times out, and its
    exit code *is* the answer: 0 for yes, 3 for no.
    """
    action = args.confirm_cmd
    timeout = 15.0 if action in ("list", "yes", "no") else args.timeout + 15
    with Client(timeout=timeout) as client:
        if action == "list":
            resp = client.call("confirm", action="list")
        elif action in ("yes", "no"):
            resp = client.call("confirm", action=action, token=args.token,
                               by="user")
        else:
            resp = client.call("confirm", action="ask",
                               **{"class": args.klass},
                               detail=" ".join(args.detail),
                               why="a dispatched agent asked first",
                               actor="agent")
    if args.json:
        print(json.dumps(resp, indent=2))
        return 0 if resp.get("ok") else 1
    if not resp.get("ok"):
        return fail(resp)

    if action == "list":
        pol = resp["policies"]
        print(f"{BOLD}policies{RESET} "
              f"{DIM}({resp['channel']}, {resp['timeout_s']:.0f}s, "
              f"timeout = {resp['default_on_timeout']}){RESET}")
        for name, value in pol.items():
            mark = {"never": DIM, "ask": "", "deny": BOLD}.get(value, "")
            print(f"  {name:<20} {mark}{value}{RESET}")
        print(f"{DIM}always denied: {', '.join(resp['hard_denies'])}{RESET}")
        if not resp["pending"]:
            print(f"{DIM}nothing waiting on an answer{RESET}")
            return 0
        print(f"\n{BOLD}waiting{RESET}")
        for item in resp["pending"]:
            print(f"  {item['token']}  {item['action']}  "
                  f"{item['remaining_s']:.0f}s left")
            print(f"    {item['detail'][:120]}")
            print(f"    {DIM}luna confirm yes {item['token']}  |  "
                  f"luna confirm no {item['token']}{RESET}")
        return 0

    if action in ("yes", "no"):
        if not resp["answered"]:
            sys.stderr.write(f"luna: {resp['note']}\n")
            return 1
        print(f"{'approved' if resp['allow'] else 'declined'} {resp['token']}")
        return 0

    print(resp["message"])
    return 0 if resp["allowed"] else 3


def cmd_log(args: argparse.Namespace) -> int:
    path = config.LOG_PATH
    if not path.exists():
        sys.stderr.write(f"luna: no log at {path} yet\n")
        return 1
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    for line in lines[-args.lines:]:
        if args.raw:
            print(line)
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            print(line)
            continue
        extra = " ".join(
            f"{k}={v}" for k, v in rec.items()
            if k not in ("ts", "level", "logger", "msg", "exc")
        )
        print(f"{DIM}{rec['ts']}{RESET} {rec['level']:<7} {rec['msg']} "
              f"{DIM}{extra}{RESET}")
        if "exc" in rec:
            print(rec["exc"])
    return 0


def cmd_cancel(args: argparse.Namespace) -> int:
    with Client(timeout=15) as client:
        resp = client.call("cancel", target=args.target, all=args.all)
    if not resp.get("ok"):
        return fail(resp)
    print(f"cancelled {resp['cancelled']}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    # `jarvis` and `luna` are the same client; argv[0] decides only the name
    # in the help text, because the app is Jarvis and the assistant inside it
    # is called whatever `[assistant] name` says.
    prog = Path(sys.argv[0]).name or "luna"
    p = argparse.ArgumentParser(
        prog=prog, description="Talk to your assistant (Jarvis).")
    p.add_argument("--json", action="store_true", help="raw JSON response")
    sub = p.add_subparsers(dest="cmd", required=True)

    ask = sub.add_parser("ask", help="ask Luna something")
    ask.add_argument("prompt", nargs="*")
    ask.add_argument("--model", default=None)
    ask.add_argument("--surface", default="cli",
                     help="cli | voice | palette; voice also speaks the reply")
    ask.add_argument("--conversation", default=None,
                     help="session key; turns in one conversation share a "
                          "warm prompt cache")
    ask.add_argument("--speak", action="store_true",
                     help="speak the reply whatever the surface")
    ask.add_argument("--timeout", type=float, default=180.0)
    ask.add_argument("--no-remember", action="store_true",
                     help="do not record this exchange in episodic memory")
    ask.add_argument("-v", "--verbose", action="store_true",
                     help="print model, latency and cost to stderr")
    ask.set_defaults(func=cmd_ask)

    st = sub.add_parser("status", help="daemon and memory state")
    st.set_defaults(func=cmd_status)

    mem = sub.add_parser("memory", help="inspect and edit memory")
    msub = mem.add_subparsers(dest="mem_cmd", required=True)
    show = msub.add_parser("show", help="show curated memory and recent episodes")
    show.add_argument("file", nargs="?", default=None,
                      help="LUNA.md or USER.md; omit for everything")
    show.add_argument("--limit", type=int, default=10)
    search = msub.add_parser("search", help="keyword search of episodic memory")
    search.add_argument("query", nargs="+")
    search.add_argument("--limit", type=int, default=10)
    write = msub.add_parser("write", help="append a curated entry")
    write.add_argument("entry", nargs="+")
    write.add_argument("--file", default="LUNA.md")
    write.add_argument("--limit", type=int, default=10)
    rm = msub.add_parser("rm", help="remove a curated entry by index")
    rm.add_argument("index", type=int)
    rm.add_argument("--file", default="LUNA.md")
    rm.add_argument("--limit", type=int, default=10)
    prof = msub.add_parser("profile",
                           help="the derived profile (tier 3), as the "
                                "consolidation pass reads it")
    prof.add_argument("--rebuild", action="store_true",
                      help="regenerate it from episodic memory first")
    prof.add_argument("--limit", type=int, default=10)
    mem.set_defaults(func=cmd_memory)

    lg = sub.add_parser("log", help="tail the daemon log")
    lg.add_argument("-n", "--lines", type=int, default=40)
    lg.add_argument("--raw", action="store_true")
    lg.set_defaults(func=cmd_log)

    sy = sub.add_parser("say", help="speak text aloud through piper")
    sy.add_argument("text", nargs="*")
    sy.add_argument("--wait", action="store_true",
                    help="block until playback finishes")
    sy.add_argument("--timeout", type=float, default=120.0)
    sy.set_defaults(func=cmd_say)

    hu = sub.add_parser("hush", help="stop speaking now")
    hu.set_defaults(func=cmd_hush)

    ss = sub.add_parser("session", help="conversation session control")
    ss.add_argument("action", choices=["reset"])
    ss.add_argument("conversation", nargs="?", default=None)
    ss.set_defaults(func=cmd_session)

    cp = sub.add_parser("codex-profile",
                        help="write the `luna` codex profile so that "
                             "`codex -p luna` boots Codex as Luna")
    cp.set_defaults(func=cmd_codex_profile)

    dp = sub.add_parser("dispatch", help="hand a task to an agent in the "
                                        "luna workspace")
    dp.add_argument("task", nargs="*")
    dp.add_argument("--to", default="worker", choices=["worker", "sol"],
                    help="sol is the specialist: own prompt, own memory")
    dp.add_argument("--wait", action="store_true",
                    help="block until the job finishes and print its output")
    dp.add_argument("--timeout", type=float, default=3600.0)
    dp.set_defaults(func=cmd_dispatch)

    jb = sub.add_parser("jobs", help="dispatched work, newest first")
    jb.add_argument("-n", "--limit", type=int, default=20)
    jb.add_argument("--output", action="store_true",
                    help="include what each job wrote")
    jb.add_argument("--cancel", default=None, metavar="JOB_ID")
    jb.set_defaults(func=cmd_jobs)

    pk = sub.add_parser("peek", help="show or hide the luna workspace")
    pk.set_defaults(func=cmd_peek)

    au = sub.add_parser("audit", help="read the append-only audit log")
    au.add_argument("--since", default=None,
                    help="30m, 6h, 2d, 1w, YYYY-MM-DD, or a unix timestamp")
    au.add_argument("-n", "--limit", type=int, default=40)
    au.add_argument("--action", default=None,
                    help="only actions starting with this prefix")
    au.set_defaults(func=cmd_audit)

    sp = sub.add_parser("spawned",
                        help="the signal allowlist; --check asks the firewall "
                             "about one pid")
    sp.add_argument("--check", type=int, default=None, metavar="PID")
    sp.add_argument("--all", action="store_true",
                    help="include records whose process has exited")
    sp.set_defaults(func=cmd_spawned)

    se = sub.add_parser("settings",
                        help="read and write ~/.config/jarvis/config.toml")
    sesub = se.add_subparsers(dest="set_cmd", required=False)
    seshow = sesub.add_parser("show", help="print the live settings")
    seshow.add_argument("key", nargs="?", default=None,
                        help="one dotted key, e.g. voice.voice")
    seset = sesub.add_parser("set", help="change one setting")
    seset.add_argument("key")
    seset.add_argument("value")
    se.set_defaults(func=cmd_settings, set_cmd="show", key=None)

    cf = sub.add_parser("confirm",
                        help="the confirmation policy, and answers to it")
    cfsub = cf.add_subparsers(dest="confirm_cmd", required=False)
    cfsub.add_parser("list", help="policies and anything waiting for an answer")
    cfyes = cfsub.add_parser("yes", help="approve a pending question")
    cfyes.add_argument("token")
    cfno = cfsub.add_parser("no", help="decline a pending question")
    cfno.add_argument("token")
    cfask = cfsub.add_parser(
        "ask", help="ask the user before doing something; exits 0 for yes, "
                    "3 for no. This is the gate a dispatched agent calls.")
    cfask.add_argument("klass", metavar="CLASS")
    cfask.add_argument("detail", nargs="*")
    cfask.add_argument("--timeout", type=float, default=120.0)
    cf.set_defaults(func=cmd_confirm, confirm_cmd="list")

    cn = sub.add_parser("cancel", help="cancel an in-flight request")
    cn.add_argument("target", nargs="?", default=None)
    cn.add_argument("--all", action="store_true")
    cn.set_defaults(func=cmd_cancel)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if not hasattr(args, "json"):
        args.json = False
    try:
        return args.func(args)
    except KeyboardInterrupt:
        sys.stderr.write("\nluna: interrupted\n")
        return 130
    except socket.timeout:
        sys.stderr.write("luna: timed out waiting for the daemon\n")
        return 75


if __name__ == "__main__":
    raise SystemExit(main())
