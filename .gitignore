__pycache__/
*.pyc
.venv/

# Secrets never enter this repo. Jarvis keeps its key in
# ~/.config/jarvis/secrets.env (0600), supplied to lunad by a systemd drop-in,
# and never in config.toml. These patterns are belt and braces: if a key ever
# ends up in the working tree by accident, git will not offer to commit it.
secrets*
*.env
*.env.*
.envrc
*.key
*.pem

# Models are user state, not source. `python3 -m lunad.embed fetch` puts the
# 86 MB embedding model in ~/.local/share/luna/models/, outside the tree
# entirely — these patterns exist for the day somebody fetches into the repo
# by accident, because an 86 MB blob is very hard to take back out of git.
*.onnx
models/
vocab.txt
